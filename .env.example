# -----------------------------------------------------------------------------
# PixelRush Arcade configuration
#
# Copy this file to `.env.local` for local development. Never commit
# `.env.local` (it is git-ignored). In production, set these values in your
# hosting provider's dashboard (e.g. Vercel -> Project -> Settings ->
# Environment Variables).
#
# Every value here is OPTIONAL. With everything empty the site builds and runs
# with analytics and advertising disabled.
#
# NOTE: NEXT_PUBLIC_* values are embedded into the static files at build time.
# After changing one, rebuild and redeploy. Do not put secrets in them.
# -----------------------------------------------------------------------------

# Canonical production URL, e.g. https://www.example.com (no trailing slash).
# Used for canonical tags, Open Graph URLs, sitemap.xml and robots.txt.
# If empty on Vercel, the project's production *.vercel.app domain is used.
# If empty elsewhere, http://localhost:3000 is used (fine locally, NOT for launch).
NEXT_PUBLIC_SITE_URL=

# Public contact address shown on /contact. Leave empty until you have a
# mailbox you actually monitor.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google Analytics 4 (optional) -------------------------------------------
# Measurement ID, format G-XXXXXXXXXX. Empty = analytics disabled.
NEXT_PUBLIC_GA_ID=
# Google consent mode default for analytics/ad storage: "denied" (default) or
# "granted". Keep "denied" unless your consent setup and legal review allow
# otherwise. See docs/MONETIZATION.md and docs/SEO_CHECKLIST.md.
NEXT_PUBLIC_ANALYTICS_CONSENT_DEFAULT=denied

# --- Google AdSense (optional, disabled by default) --------------------------
# Ads load ONLY when NEXT_PUBLIC_ADS_ENABLED is exactly "true" AND the client
# ID is a valid publisher ID (format ca-pub-0000000000000000).
# Do not enable until your AdSense account and site are approved.
# A valid client ID on its own adds Google's AdSense loader script to every
# page so AdSense can verify the site. It renders no ad units, but Google can
# still show Auto ads through it if they are switched on in your AdSense account.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Ad unit (slot) IDs created in your AdSense account (numeric). A placement
# without a valid slot ID renders nothing.
NEXT_PUBLIC_ADSENSE_SLOT_GAME_PAGE=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT_PAGE=
